{
  "name": "gesp6-web-html",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "// dev:test 说明": "测试用 dev server：关闭中间件限流（GESP6_RATE_LIMIT_ENABLED=0），供 E2E 密集请求。playwright.config webServer 默认用它；手动跑 E2E 前请先用它起服务，否则 20 次/分/IP 限流会导致导航/平台输入等用例假失败。",
    "dev:test": "GESP6_RATE_LIMIT_ENABLED=0 GESP6_RATE_LIMIT_MAX=100000 next dev",
    "build": "next build",
    "start": "next start",
    "// ===== 代码规范与类型检查（技术大类）===== ": "",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "// ===== 数据库迁移（generate 用 drizzle-kit；migrate 走程序化入口，见 app/lib/db/migrate.ts 头注释）===== ": "",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx app/lib/db/migrate.ts",
    "// ===== 跨类别聚合命令（聚合置顶，最常用）===== ": "",
    "test:quick": "npm run test:unit && npm run test:integration && npm run test:e2e:no-llm",
    "test:full": "npm run test && npm run test:e2e",
    "// ===== 单元+集成测试（vitest 大类）聚合命令 ===== ": "",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "// ===== 单元测试（技术小类，vitest，**/__tests__/**，无需模型全 mock）===== ": "",
    "test:unit": "vitest run __tests__",
    "// ===== 集成测试（技术小类，vitest，tests/integration-tests/）===== ": "",
    "test:integration": "vitest run tests/integration-tests",
    "// ===== E2E 测试（Playwright 大类）聚合命令（集合所有业务小类，含 @llm，分钟级）===== ": "",
    "test:e2e": "playwright test",
    "// --- E2E 业务小类：冒烟核心（smoke + navigation，秒级无需模型）---": "",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "// --- E2E 业务小类：解题主流程（solve-text/image/platform，需模型）---": "",
    "test:e2e:solve": "playwright test tests/e2e-tests/specs/solve-text.spec.ts tests/e2e-tests/specs/solve-image.spec.ts tests/e2e-tests/specs/solve-platform.spec.ts",
    "// --- E2E 业务小类：SSO 认证（sso-login，需真实 IDP，需模型）---": "",
    "test:e2e:sso": "playwright test tests/e2e-tests/specs/sso-login.spec.ts",
    "// --- E2E 业务小类：输入校验（validation + platform-input + api-contract）---": "",
    "test:e2e:validation": "playwright test tests/e2e-tests/specs/validation.spec.ts tests/e2e-tests/specs/platform-input.spec.ts tests/e2e-tests/specs/api-contract.spec.ts --workers=2",
    "// --- E2E 业务小类：结果容错（result-resilience）---": "",
    "test:e2e:resilience": "playwright test tests/e2e-tests/specs/result-resilience.spec.ts --workers=2",
    "// --- E2E 业务小类：图片上传（image-upload）---": "",
    "test:e2e:image": "playwright test tests/e2e-tests/specs/image-upload.spec.ts --workers=2",
    "// --- E2E 技术标签命令（按标签筛选，保留）---": "",
    "test:e2e:no-llm": "playwright test --grep @no-llm --workers=2",
    "test:e2e:llm": "playwright test --grep @llm",
    "// --- E2E 交互式 UI 模式（含 @llm，需要模型）---": "",
    "test:e2e:ui": "playwright test --ui --ui-host=0.0.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.8",
    "lru-cache": "^11.5.1",
    "lucide-react": "^1.21.0",
    "next": "15.1.6",
    "openai": "^4.77.0",
    "pg": "^8.23.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
