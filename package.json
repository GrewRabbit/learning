{
  "name": "gesp6-web-html",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",

    "// === 单元+集成测试（vitest，无需调用模型，全 mock）===": "",
    "test": "vitest run",

    "// === 单元+集成测试 + 覆盖率报告（无需调用模型）===": "",
    "test:coverage": "vitest run --coverage",

    "// === E2E 烟测（仅 @smoke，关键路径快速验证，秒级，无需模型）===": "",
    "test:e2e:smoke": "playwright test --grep @smoke",

    "// === E2E 无需模型测试（@no-llm，UI/校验/契约/容错，秒级）===": "",
    "test:e2e:no-llm": "playwright test --grep @no-llm --workers=2",

    "// === E2E 需要模型测试（@llm，solve 完整流程，分钟级，消耗 token）===": "",
    "test:e2e:llm": "playwright test --grep @llm",

    "// === E2E 全部测试（含 @llm，需要模型，分钟级）===": "",
    "test:e2e": "playwright test",

    "// === E2E 交互式 UI 模式（含 @llm，需要模型）===": "",
    "test:e2e:ui": "playwright test --ui --ui-host=0.0.0.0",

    "// === 快速测试（单元+集成 + E2E 无需模型，本地快速反馈）===": "",
    "test:quick": "vitest run && playwright test --grep @no-llm --workers=2",

    "// === 全部测试（单元+集成 + 全部 E2E，含 @llm，发布前完整验证）===": "",
    "test:full": "vitest run && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lru-cache": "^11.5.1",
    "lucide-react": "^1.21.0",
    "next": "15.1.6",
    "openai": "^4.77.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
