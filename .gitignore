# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 临时产物（subagent 运行缓存等）
/tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env*.local
.env

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/
.idea/

# workZone (gesp6-solution skill 运行时产物，含编译二进制与字体)
/workZone/

# FsHtmlCache 持久化缓存（LLM 生成的 HTML 落盘，GESP6_CACHE_DRIVER=fs 时启用）
/data/

# 运行时日志（curl 测试 / 调试输出）
/log

# playwright (E2E 测试输出：截图、视频、trace、SSO 登录会话)
/tests/e2e-tests/.output/
/tests/e2e-tests/.auth/
/test-results/
/playwright-report/

# coverage (vitest 覆盖率报告，P0-1 启用)
/coverage/
