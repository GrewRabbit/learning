# AI 模型配置（FR-010）
#
# ============================================================
# 推理模型选择（文本模型：生成 HTML 解题方案）
# ============================================================
# 切换推理模型：修改下面两个变量即可，无需改代码
#   - GLM-5.2:      AI_TEXT_PROVIDER=glm     AI_TEXT_MODEL=glm-5.2
#   - DeepSeek v4:  AI_TEXT_PROVIDER=deepseek AI_TEXT_MODEL=deepseek-v4-flash
#   - Kimi:         AI_TEXT_PROVIDER=kimi    AI_TEXT_MODEL=kimi-vision
AI_TEXT_PROVIDER=glm
AI_TEXT_MODEL=glm-5.2

# 视觉模型：图片识别转文字（Qwen3.7-Plus 多模态，阿里云百炼 OpenAI 兼容接口）
AI_VISION_PROVIDER=qwen
AI_VISION_MODEL=qwen3.7-plus

# ============================================================
# 各厂商 API Key（仅服务端，禁止 NEXT_PUBLIC_ 前缀，NFR-009）
# 仅配置你实际使用的厂商即可，未使用的可留空
# ============================================================
GLM_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

# 各厂商 API Base URL（OpenAI 兼容，SDK 自动追加 /chat/completions）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_BASE_URL=https://api.moonshot.cn/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============================================================
# SSO 单点登录（真实生产 IDP：auth.happyrabbit.top）
# ============================================================
# 服务端（Node 层，禁止 NEXT_PUBLIC_ 前缀，违者启动报错）
SSO_ISSUER=https://auth.happyrabbit.top
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# 浏览器可见（NEXT_PUBLIC_ 前缀，无敏感值）
NEXT_PUBLIC_SSO_ISSUER=https://auth.happyrabbit.top
NEXT_PUBLIC_SSO_CLIENT_ID=
NEXT_PUBLIC_SSO_REDIRECT_URI=http://localhost:3000/api/sso/callback
NEXT_PUBLIC_SSO_SCOPE=openid profile email groups offline_access
# 浏览器可见：Header 入口
NEXT_PUBLIC_SSO_DASHBOARD_URL=https://auth.happyrabbit.top/dashboard
NEXT_PUBLIC_SSO_REGISTER_URI=https://auth.happyrabbit.top/zh-CN/register

# ============================================================
# 数据库（数据库与业务系统整合，架构 §7.2；仅服务端，禁止 NEXT_PUBLIC_ 前缀）
# 校验方式：getDbConfig() 惰性校验（app/lib/db/config.ts），不并入启动校验（AD-07）
# ============================================================
# PostgreSQL 连接串（postgres://user:password@host:port/dbname）
# 仅写入 .env.local / 部署 secret，禁硬编码、禁打印（NFR-005）
DATABASE_URL=
# 连接池最小连接数（默认 2）
GESP6_DB_POOL_MIN=
# 连接池最大连接数（默认 10）
GESP6_DB_POOL_MAX=
# 服务端语句超时毫秒 statement_timeout（默认 5000）
GESP6_DB_STATEMENT_TIMEOUT_MS=
# 连接超时毫秒 connectionTimeoutMillis（默认 5000）
GESP6_DB_CONNECT_TIMEOUT_MS=
# 新用户赠送免费额度次数（默认 5）
GESP6_FREE_QUOTA_INITIAL=
# 单次计费消耗额度次数（默认 1）
GESP6_SOLUTION_PRICE=
# 计费降级开关：0=fail-closed（默认），1=显式开启 fail-open（应急放行不计费）
GESP6_BILLING_DEGRADE_OPEN=
# 解法缓存驱动：memory / fs / db（默认 memory；本机现状已设 fs，本期新增 db 值）
GESP6_CACHE_DRIVER=
