# AI 模型配置（FR-010）
# 文本模型：推理生成 HTML（DeepSeek / GLM / Kimi 任选）
AI_TEXT_PROVIDER=deepseek
AI_TEXT_MODEL=deepseek-v4-flash

# 视觉模型：图片识别转文字（Qwen3.7-Plus 多模态）
AI_VISION_PROVIDER=qwen
AI_VISION_MODEL=qwen3.7-plus

# 各厂商 API Key（仅服务端，禁止 NEXT_PUBLIC_ 前缀，NFR-009）
GLM_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=

# 各厂商 API Base URL（OpenAI 兼容）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DEEPSEEK_BASE_URL=https://api.deepseek.com
KIMI_BASE_URL=https://api.moonshot.cn/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
